PewterCity_Museum_1F_EventScript_Scientist1::
	lockall
	faceplayer
	msgbox PewterCity_Museum_1F_Text_WeHaveTwoFossilsOnExhibit
	waitmessage
	applymovement LOCALID_MUSEUM_SCIENTIST1, Common_Movement_FaceOriginalDirection
	waitmovement 0
	releaseall
	end

